#!/bin/sh
# Hands a Codex hook event to turnray.app. Never fails and never prints: the exit
# code and stdout of a hook steer Codex (exit 2 rejects a prompt or continues a Stop).
dirs=${TURNRAY_HOOK_APP_DIRS-/Applications:$HOME/Applications}
found=
old_ifs=$IFS
IFS=:
set -f
for dir in $dirs; do
	app=$dir/turnray.app
	if [ "$(cat "$app/Contents/Resources/hook-protocol-codex" 2>/dev/null)" = 1 ] && [ -x "$app/Contents/MacOS/turnray" ]; then
		found=$app
		break
	fi
done
IFS=$old_ifs
set +f
if [ -n "$found" ]; then
	"$found/Contents/MacOS/turnray" hook codex >/dev/null 2>&1
else
	cat >/dev/null
fi
exit 0
